# =========================================================
# CureLiynk medical assistant - environment
#
# Copy to .env and fill in. Never commit the real .env.
# =========================================================

# ---------------------------------------------------------
# API SECURITY  (required)
# ---------------------------------------------------------
#
# The Node API owns sign-in and mints the tokens; this service verifies them
# with the same secret. JWT_SECRET is what connects the two — set it, or the
# endpoint is open to anyone who can reach the port.

# "development" | "staging" | "production".
# Production hides /docs and refuses to start without JWT_SECRET, or with a
# wildcard host or origin.
ENVIRONMENT=development

# The Node API's JWT_SECRET, copied EXACTLY. It signs access tokens (HS256,
# 15-minute life) and this service verifies them with the same value, so the
# app signs in once and both services accept the same bearer token.
#
# A mismatch does not fail loudly at boot — both services start fine and every
# medical request comes back 401 — so if the app can sign in but the AI chat
# says "please sign in again", check this first.
#
# Leave it blank ONLY for local work on the pipeline: the endpoint then runs
# with no authentication and logs a warning on every request. Production
# refuses to start this way.
#
# Do NOT put a "#" in the secret. It opens a comment in a .env file, and the
# parsers disagree about it: Node's dotenv cuts the value off there, Python's
# python-dotenv keeps the rest. The two services then hold different keys
# from the same text, every token fails to verify, and the app claims your
# session ended. This service refuses to start if it sees one.
#
# Generate a safe one:  openssl rand -hex 32
JWT_SECRET=

# Browser origins allowed to call this API, comma separated. The mobile app is
# NOT affected by this - native builds send no Origin header. This is for the
# Vite web frontend and Expo web.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host header allowlist. Set this to your real domain before going live;
# "*" is only acceptable in development.
ALLOWED_HOSTS=*

# Requests allowed per caller per window. Each one costs an embedding pass, a
# rerank and at least one paid LLM call, so this is a bill control too. With
# JWT_SECRET set the window is per account; without it, per client address —
# and everyone behind one NAT or carrier gateway then shares a window.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Longest symptom description accepted, in characters.
MAX_QUERY_CHARS=800

# ---------------------------------------------------------
# AI PROVIDERS  (required)
# ---------------------------------------------------------

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ---------------------------------------------------------
# RETRIEVAL  (required)
# ---------------------------------------------------------

PINECONE_API_KEY=
PINECONE_INDEX_NAME=medical-knowledge
PINECONE_NAMESPACE=medical_knowledge

# ---------------------------------------------------------
# DOCTOR SEARCH  (required)
# ---------------------------------------------------------

# Google Places, used for the nearby-specialist search.
GOOGLE_MAPS_API_KEY=

# Optional alternative provider.
GEOAPIFY_API_KEY=

# Local doctor database, used when the maps search finds nobody in range.
MONGODB_URI=
MONGODB_DATABASE=medical_assistant
MONGODB_COLLECTION=doctors

# ---------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------

GROQ_API_KEY=
OLLAMA_MODEL=qwen3:4b
OLLAMA_HOST=http://localhost:11434
