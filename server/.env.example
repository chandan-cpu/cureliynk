# =============================================================================
# CureLiynk — Node API (server/)
#
# Copy to server/.env and fill in. server/.env is gitignored; never commit it.
# The server refuses to start if anything marked REQUIRED is missing — see
# src/config/env.js.
# =============================================================================

# --- Runtime ---------------------------------------------------------------

# "production" turns on HSTS, enforces the CORS allowlist, and stops internal
# error messages being returned to clients. Leave unset for local development.
NODE_ENV=development

PORT=5000

# --- Database (REQUIRED) ---------------------------------------------------

# Full MongoDB connection string. Contains credentials — keep it out of logs
# and out of git.
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/cureliynk

MONGODB_COLLECTION=cureliynk

# --- Auth secrets (REQUIRED) -----------------------------------------------
#
# Generate each one separately:  openssl rand -hex 32
#
# They must be at least 32 characters and must NOT be equal to each other — a
# shared secret means a 7-day refresh token is accepted anywhere a 15-minute
# access token is. Startup refuses both cases.
#
# The Python assistant (CureliynkMedical/backend) verifies tokens minted here,
# so its JWT_SECRET must match this JWT_SECRET exactly.
JWT_SECRET=
JWT_REFRESH_SECRET=

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Admin registration (REQUIRED in production) ---------------------------

# Guards POST /api/v1/auth/register/admin. Anyone holding this can create an
# admin account, so treat it like a password: 32+ characters, rotate if leaked.
ADMIN_SECRET_KEY=

# --- CORS (REQUIRED in production) -----------------------------------------
#
# Comma-separated list of browser origins allowed to call this API. Native
# mobile builds send no Origin header and are unaffected, so this only needs
# the web frontends.
#
# In development, leaving it empty allows any origin. In production, leaving it
# empty blocks every browser origin and startup fails.
ALLOWED_ORIGINS=https://app.cureliynk.com,http://localhost:5173

# --- Google sign-in (REQUIRED in production) -------------------------------

# The OAuth 2.0 *Web* client ID from Google Cloud Console. Must match the
# audience of the ID tokens the mobile app sends to POST /api/v1/auth/google.
GOOGLE_CLIENT_ID=

# --- Third-party APIs ------------------------------------------------------
#
# Both are billed per call and both sit behind authentication and a per-caller
# rate limit. Restrict them in their provider console as well (HTTP referrer /
# IP restrictions) so a leaked key is not usable from anywhere.

# Google Places text search, for POST /api/v1/chat/doctors
GOOGLE_MAPS_API_KEY=

# Gemini, for POST /api/v1/chat. Sent as an x-goog-api-key header, never in
# the URL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# --- Password reset (optional) ----------------------------------------------
#
# SMTP credentials used to send POST /api/v1/auth/forgot-password reset links.
# If left unset, the reset link is logged to the server console instead of
# emailed — fine for local development, not for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Base URL the reset-password screen lives at. The raw token is appended as
# ?token=... — this is a client route, not the API endpoint itself.
#
# The mobile app registers the "mobile" scheme (see mobile/app.json) and
# expo-router maps mobile://reset-password straight to app/reset-password.tsx,
# so this is the deep link that actually opens today. Point it at a real
# https:// page instead once one exists — most mail clients handle a universal
# link more reliably than a custom scheme.
PASSWORD_RESET_URL=mobile://reset-password

# --- Refill reminder job (optional) ------------------------------------------
#
# Daily sweep that flags medications running low, so GET /api/v1/medications/refills
# has something to return. Defaults to 08:00 Asia/Kolkata; override only if you
# want a different time. Dose reminders are NOT sent from here — those fire
# locally on each device.
REFILL_CHECK_CRON=0 8 * * *
REFILL_CHECK_TZ=Asia/Kolkata

# Legacy alias for GOOGLE_MAPS_API_KEY, still read as a fallback by
# src/services/doctor.service.js. Set GOOGLE_MAPS_API_KEY above instead; this
# exists so an older .env keeps working.
# GOOGLE_PLACES_API_KEY=
